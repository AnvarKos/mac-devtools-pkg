#!/bin/bash
exec > /var/log/setup-dev-tools.log 2>&1
echo "=== Setup started: $(date) ==="

# --- CLT ---
if ! xcode-select -p &>/dev/null; then
    touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    sleep 5
    PROD=$(softwareupdate -l 2>/dev/null | grep -B 1 -E "Command Line Tools" | awk -F'"' '/Label:/ {print $2}' | tail -1)
    [ -n "$PROD" ] && softwareupdate -i "$PROD" --verbose
    rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
fi

# --- Homebrew ---
LOGGED_IN_USER=$(scutil <<< "show State:/Users/ConsoleUser" | awk '/Name :/ && ! /loginwindow/ { print $3 }')
USER_HOME=$(dscl . -read "/Users/$LOGGED_IN_USER" NFSHomeDirectory | awk '{print $2}')

if [ -z "$LOGGED_IN_USER" ]; then
    echo "ERROR: No logged in user found, cannot install Homebrew (must not run as root)"
    exit 1
fi

if [[ $(uname -m) == "arm64" ]]; then
    BREW_PATH="/opt/homebrew/bin/brew"
else
    BREW_PATH="/usr/local/bin/brew"
fi

# Временно разрешаем пользователю sudo без пароля — Homebrew installer сам
# запрашивает sudo, а неинтерактивно ввести пароль здесь невозможно.
# Мы уже выполняемся от root (это postinstall pkg), поэтому это безопасно.
SUDOERS_FILE="/etc/sudoers.d/99-frhc-brew-install"
echo "$LOGGED_IN_USER ALL=(ALL) NOPASSWD: ALL" > "$SUDOERS_FILE"
chmod 440 "$SUDOERS_FILE"

if [ ! -f "$BREW_PATH" ]; then
    echo "Installing Homebrew as user: $LOGGED_IN_USER"
    sudo -u "$LOGGED_IN_USER" -H bash -c "export NONINTERACTIVE=1; export HOME=$USER_HOME; /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
fi

sudo -u "$LOGGED_IN_USER" bash -c "grep -qxF 'eval \"\$($BREW_PATH shellenv)\"' $USER_HOME/.zprofile || echo 'eval \"\$($BREW_PATH shellenv)\"' >> $USER_HOME/.zprofile"

if [ ! -f "$BREW_PATH" ]; then
    echo "ERROR: Homebrew installation failed, brew binary not found at $BREW_PATH"
    rm -f "$SUDOERS_FILE"
    exit 1
fi

# --- Brewfile ---
cat > /tmp/Brewfile << 'EOF'
cask "claude"
cask "claude-code"
cask "yandex-disk"
cask "obsidian"
cask "notion"
cask "asana"
cask "keepassxc"
cask "telegram"
cask "discord"
cask "whatsapp"
cask "google-chrome"
brew "python@3.12"
EOF

chown "$LOGGED_IN_USER" /tmp/Brewfile
sudo -u "$LOGGED_IN_USER" -H bash -c "export HOME=$USER_HOME; $BREW_PATH bundle install --file=/tmp/Brewfile"

# Убираем временное разрешение sudo без пароля
rm -f "$SUDOERS_FILE"

echo "=== Setup finished: $(date) ==="
exit 0
